{
  "name": "blank-delay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "electron .",
    "optimizer": "electron ./electron/optimizer-main.js",
    "build:controller": "vite build --base ./ --outDir dist-app",
    "pack:controller": "electron-builder --win portable",
    "build:keyboard": "vite build --config vite.keyboard.config.js",
    "pack:keyboard": "electron-builder --win portable --config electron-builder.keyboard.json",
    "build:optimizer": "vite build --config vite.optimizer.config.js",
    "pack:optimizer": "electron-builder --win portable --config electron-builder.optimizer.json"
  },
  "build": {
    "appId": "com.blankdelay.controlleroptimizer",
    "productName": "Blank Delay Controller Optimizer",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "build/Release/blank_delay_engine.node"
    ],
    "files": [
      "dist-app/**",
      "electron/**",
      "src/main/**",
      "build/Release/blank_delay_engine.node",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/controller-main.js"
    },
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "electron/blank-delay.ico"
    },
    "portable": {
      "artifactName": "Blank Delay Controller Optimizer.exe"
    }
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.51.0",
    "node-addon-api": "8.5.0",
    "nodemailer": "^7.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^23.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
