# Server
PORT=3000
PUBLIC_URL=http://localhost:3000
ADMIN_TOKEN=change-me-to-a-long-secret

# Stripe (Dashboard → Developers → API keys / Webhooks)
# Leave blank until ready — placeholders are ignored
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email delivery (Gmail app password OR any SMTP)
# Leave blank to assign keys without sending email yet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Discord bot (Discord Developer Portal → Bot)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: only allow key commands in this guild
DISCORD_GUILD_ID=
